# Copy this file to .env.local and fill in values from
# Supabase dashboard -> Project Settings -> API
#
# If these are left empty the app runs in local Demo mode
# (browser storage, not shared with your team).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: name shown in the header
NEXT_PUBLIC_TEAM_NAME=My Team

# Only needed to run migrations from the command line (npm run migrate).
# Dashboard -> Project Settings -> Database -> Connection string (Direct).
# Special characters in the password are handled by scripts/migrate.js, so
# paste the URI exactly as Supabase shows it.
DATABASE_URL=
